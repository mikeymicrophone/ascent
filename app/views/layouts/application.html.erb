<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ascent" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="view-transition" content="same-origin">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= load_google_fonts %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <% if Rails.env.development? %>
      <% tailwind_build = Rails.root.join("app/assets/builds/tailwind.css") %>
      <%= tag.link rel: "stylesheet",
                   href: "/dev-assets/tailwind.css?v=#{tailwind_build.exist? ? tailwind_build.mtime.to_i : Time.now.to_i}",
                   "data-turbo-track": "reload" %>
    <% else %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= "auth-page" if content_for?(:authentication_page) %>" data-controller="butterfly" data-butterfly-level-value="<%= controller_name %>" data-butterfly-enabled-value="<%= !content_for?(:authentication_page) %>" data-butterfly-log-level-value="debug">
    <% if content_for?(:authentication_page) %>
      <header class="auth-header">
        <%= link_to root_path, class: "auth-product", aria: { label: "Ascent home" } do %>
          <%= render Views::Components::BrandMark.new %>
          <span>Ascent</span>
        <% end %>
        <%= link_to "Back to Ascent", root_path, class: "auth-back" %>
      </header>
    <% else %>
      <%= render Views::Components::Navigation.new %>
    <% end %>
    <main class="<%= content_for?(:authentication_page) ? "auth-main" : "main-content" %>" id="main-content">
      <%= render Views::Components::FlashMessages.new %>
      <%= yield %>
    </main>
  </body>
</html>
