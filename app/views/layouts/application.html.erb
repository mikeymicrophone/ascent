<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ascent" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= load_google_fonts %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <% if Rails.env.development? %>
      <% tailwind_build = Rails.root.join("app/assets/builds/tailwind.css") %>
      <%= tag.link rel: "stylesheet",
                   href: "/dev-assets/tailwind.css?v=#{tailwind_build.exist? ? tailwind_build.mtime.to_i : Time.now.to_i}",
                   "data-turbo-track": "reload" %>
    <% else %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="butterfly" data-butterfly-level-value="<%= controller_name %>" data-butterfly-enabled-value="true" data-butterfly-log-level-value="debug">
    <%= render Views::Components::Navigation.new %>
    <script>document.documentElement.style.setProperty('--nav-clearance', document.querySelector('.main-navigation').offsetHeight + 'px');</script>
    <main class="main-content">
      <%= yield %>
    </main>
  </body>
</html>
