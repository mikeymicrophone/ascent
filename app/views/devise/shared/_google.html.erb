<% if Voter.google_sign_in_available? %>
  <% content_for :head do %>
    <%= tag.link rel: "stylesheet", href: "https://fonts.googleapis.com/css2?family=Google+Sans:wght@500&display=swap" %>
  <% end %>
  <%= button_to voter_google_oauth2_omniauth_authorize_path, method: :post, class: "auth-google google-sign-in", form: { data: { turbo: false } } do %>
    <%= image_tag "google-g.png", width: 20, height: 20, alt: "", aria: { hidden: true } %>
    <span>Continue with Google</span>
  <% end %>
  <div class="auth-divider"><span>or use your email</span></div>
<% end %>
