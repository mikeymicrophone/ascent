<%= render layout: "devise/shared/card", locals: { title: "Sign up", description: "Make room for your perspective." } do %>
  <%= render "devise/shared/google" %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= form_for resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" } do |form| %>
    <div class="auth-name-fields">
      <%= auth_field form, :first_name, autocomplete: "given-name", autofocus: true, required: true %>
      <%= auth_field form, :last_name, autocomplete: "family-name", required: true %>
    </div>
    <%= auth_field form, :email, type: :email, autocomplete: "email", required: true %>
    <%= auth_field form, :password, type: :password, autocomplete: "new-password", required: true,
          minlength: @minimum_password_length, hint: "At least #{@minimum_password_length} characters." %>
    <%= auth_field form, :password_confirmation, type: :password, label: "Confirm password", autocomplete: "new-password", required: true %>
    <%= form.button "Sign up", class: "auth-submit" %>
    <p class="auth-hint">We'll email you a link to confirm your account.</p>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
