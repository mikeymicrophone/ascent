<%= render layout: "devise/shared/card", locals: { title: "Confirm your email", description: "Need another confirmation link? We'll send it to your inbox." } do %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= form_for resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "auth-form" } do |form| %>
    <%= auth_field form, :email, type: :email, autofocus: true, autocomplete: "email", required: true %>
    <%= form.button "Resend confirmation instructions", class: "auth-submit" %>
  <% end %>
  <%= render "devise/shared/links" %>
<% end %>
