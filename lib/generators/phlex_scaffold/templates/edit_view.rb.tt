class Views::<%= controller_class_name %>::EditView < Views::ApplicationView
  prop :<%= singular_table_name %>, <%= class_name %>

  def view_template
    ResourceFormPage(record: @<%= singular_table_name %>) { render Views::<%= controller_class_name %>::<%= class_name %>Form.new(@<%= singular_table_name %>) }
  end
end
