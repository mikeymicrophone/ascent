class Views::<%= controller_class_name %>::<%= class_name %>Form < Views::Components::Forms::Base
  def view_template
<% form_attributes.each do |attribute| -%>
<% if attribute.password_digest? -%>
    row field(:password).password
    row field(:password_confirmation).password
<% elsif attribute.attachments? -%>
    row field(:<%= attribute.column_name %>).file(multiple: true)
<% elsif attribute.reference? -%>
<% association_name = attribute.singular_name -%>
    row field(:<%= attribute.column_name %>).collection_select(::<%= association_name.classify %>.all, text: :name, prompt: "Select <%= association_name.humanize.downcase.then { |name| name.match?(/\A[aeiou]/) ? "an #{name}" : "a #{name}" } %>")
<% elsif attribute.field_type == :textarea || attribute.field_type == :text_area -%>
    row field(:<%= attribute.column_name %>).textarea(rows: 4)
<% elsif attribute.field_type == :checkbox || attribute.field_type == :check_box -%>
    row field(:<%= attribute.column_name %>).checkbox
<% elsif attribute.field_type == :number_field -%>
    row field(:<%= attribute.column_name %>).number
<% elsif attribute.field_type == :date_field -%>
    row field(:<%= attribute.column_name %>).date
<% elsif attribute.field_type == :datetime_field || attribute.field_type == :datetime_local_field -%>
    row field(:<%= attribute.column_name %>).datetime
<% else -%>
    row field(:<%= attribute.column_name %>).text
<% end -%>
<% end -%>
  end
end
